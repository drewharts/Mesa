// Copy this file to Secrets.xcconfig (same directory) and fill in your own values.
// Secrets.xcconfig is gitignored — never commit real API keys to this repo, which is public.
//
// After creating Secrets.xcconfig, Xcode picks it up automatically (it's already wired in
// as the Debug/Release base configuration for the loc target) — no other setup needed.

GMS_API_KEY = YOUR_GOOGLE_MAPS_API_KEY_HERE
